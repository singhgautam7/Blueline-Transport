# Security headers for static hosting (Netlify / Cloudflare Pages format).
# Files in /public are copied to the export root, so this ships inside out/.
# Next.js static export cannot set headers itself — apply these at the host.
# (For Vercel use vercel.json `headers`; for nginx use add_header — see CLAUDE.md.)
#
# CSP notes:
#   • Fonts are self-hosted by next/font, so font-src 'self' is enough.
#   • The contact section embeds a Google Maps iframe -> frame-src google.com.
#   • 'unsafe-inline' for style covers inline style attributes + Next's injected
#     critical CSS. Scripts are bundled to /_next; 'unsafe-inline' kept for the
#     framework bootstrap and JSON-LD block.
#   • If you enable Web3Forms, add https://api.web3forms.com to connect-src.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' https://wa.me; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
